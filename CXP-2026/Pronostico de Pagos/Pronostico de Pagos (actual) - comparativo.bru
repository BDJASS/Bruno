meta {
  name: Pronostico de Pagos (actual) - comparativo
  type: http
  seq: 3
}

get {
  url: http://192.0.1.9:8857/RestADOSACxp/rest/RestADOSACxp/PronosticoDePagos?Fecha=2026-10-08&ProntoPago=1&Moneda=1
  body: none
